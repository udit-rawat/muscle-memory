# --- LLM providers (OpenAI-compatible endpoints) ---
# Primary: Groq free tier  -> https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
MM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
MM_PRIMARY_MODEL=openai/gpt-oss-120b

# Fallback: Google AI Studio (Gemini) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
MM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MM_FALLBACK_MODEL=gemini-3.8-flash

# --- Mock bank (synthetic operator credentials, never real) ---
MOCKBANK_URL=http://127.0.0.1:8600
MOCKBANK_USERNAME=operator1
MOCKBANK_PASSWORD=change-me-local-only
MOCKBANK_SESSION_SECRET=dev-only-session-secret
MOCKBANK_TENANT=tenant_a

# --- Operator console (human handoff) ---
MM_OPERATOR_PORT=8700

# --- Run settings ---
MM_HEADLESS=false
MM_MAX_STEPS=25
MM_RUNS_DIR=runs
